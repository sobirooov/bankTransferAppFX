<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="uz.javazam.banktransferappfx.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox>
        <VBox>
        <Label >Hisob A</Label>
        <Label fx:id="transferA">$300</Label>
        </VBox>

        <VBox>
            <Label>Hisob B</Label>
            <Label fx:id="transferB">$1200</Label>
        </VBox>
    </HBox>

    <HBox>
        <TextField fx:id="transferSum"></TextField>
    </HBox>

    <HBox>
        <VBox>
            <Button text="to B send" onAction="#send2B"/>
            <Button text="to A send" onAction="#send2A"/>
        </VBox>
    </HBox>

    <HBox>
        <Label fx:id="invalidNum"></Label>
    </HBox>

</VBox>
